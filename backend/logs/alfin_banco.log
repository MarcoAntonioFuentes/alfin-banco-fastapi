            SELECT
                COALESCE(banda_mora, 'al_dia')                        AS banda,
                COUNT(*)                                               AS cantidad,
                COALESCE(SUM(monto_aprobado), 0)                      AS monto_capital,
                COALESCE(AVG(dias_mora), 0)                           AS dias_promedio,
                COUNT(*) FILTER (WHERE estado_judicial = TRUE)         AS en_judicial,
                -- Pendiente de cobro en esa banda
                COALESCE((
                    SELECT SUM(cp.monto_cuota)
                    FROM cronograma_pagos cp
                    WHERE cp.credito_id = c.id
                      AND cp.estado IN ('pendiente','vencido')
                ), 0)                                                  AS monto_pendiente
            FROM creditos c
            WHERE estado = 'desembolsado'
            GROUP BY COALESCE(banda_mora, 'al_dia')
            ORDER BY
                CASE COALESCE(banda_mora, 'al_dia')
                    WHEN 'al_dia'     THEN 1
                    WHEN 'preventiva' THEN 2
                    WHEN 'temprana'   THEN 3
